---
import ProjectCard from '@components/ProjectCard.astro'
// import Python from '@assets/icons/python.astro';
// import Laravel from '@assets/icons/laravel.astro';
// import Docker from '@assets/icons/docker.astro';
import MySQL from '@assets/icons/mysql.astro';
// import PHP from '@assets/icons/php.astro';
import React from '@assets/icons/react.astro';
---

<section class="my-20">
  <h2 class="text-2xl font-semibold mb-2">Projects</h2>
  <hr class="mb-6 border-zinc-600">

  <ProjectCard projectTitle="Improving Skin Disease Classification with EfficientNetB0: A Deep Learning Approach to Overfitting Control" projectDescription="A deep learning approach to improve the classification of skin diseases, utilizing EfficientNetB0 to control overfitting. Published at ICOICT 2024." projectLink="https://github.com/username/skin-disease-classification">
    <!-- <Python /> -->
  </ProjectCard>

  <ProjectCard projectTitle="Transforming Indonesian Geography Education Books into Knowledge Graphs Using ChatGPT LLMs" projectDescription="Created a knowledge graph from Indonesian geography books using ChatGPT LLMs. Presented at ICOICT 2024." projectLink="https://github.com/username/indonesia-geography-graph">
    <!-- <Laravel />
    <PHP /> -->
  </ProjectCard>

  <ProjectCard projectTitle="Smart IR Remote Implementation at Telkom University Landmark Tower" projectDescription="Developed a smart IR remote system for efficient management of appliances in Telkom University's Landmark Tower." projectLink="https://github.com/username/smart-ir-remote">
    <React />
    <!-- <Docker /> -->
    <MySQL />
  </ProjectCard>

  <ProjectCard projectTitle="Community Service Metaverse World Introduction at SMA Muhammadiyah Cileungsi" projectDescription="Introduced metaverse concepts in a community service project at SMA Muhammadiyah Cileungsi, including serving as MC and final report writer." projectLink="https://github.com/username/community-service-metaverse">
    <React />
  </ProjectCard>
</section>