<section class="my-20">
  <h2 class="text-2xl font-semibold mb-2">Projects</h2>
  <hr class="mb-6 border-zinc-600">

  <ProjectCard projectTitle="Improving Skin Disease Classification with EfficientNetB0: A Deep Learning Approach to Overfitting Control" projectDescription="A deep learning approach to improve the classification of skin diseases, utilizing EfficientNetB0 to control overfitting. Published at ICOICT 2024." projectLink="https://ieeexplore.ieee.org/document/10913154">
    <!-- <Python /> -->
  </ProjectCard>

  <ProjectCard projectTitle="Transforming Indonesian Geography Education Books into Knowledge Graphs Using ChatGPT LLMs" projectDescription="Created a knowledge graph from Indonesian geography books using ChatGPT LLMs. Presented at ICOICT 2024." projectLink="https://ieeexplore.ieee.org/document/10698487">
    <!-- <Laravel />
    <PHP /> -->
  </ProjectCard>

  <ProjectCard projectTitle="Community Service Metaverse World Introduction at SMA Muhammadiyah Cileungsi" projectDescription="Introduced metaverse concepts in a community service project at SMA Muhammadiyah Cileungsi, including serving as MC and final report writer." projectLink="https://www.kompasiana.com/rifki61133/62c685594f3b543a946b3b22/dunia-baru-pendidikan-di-era-metaverse-untuk-guru-sma-muhammadiyah-cileungsi">
    <!-- <React /> -->
  </ProjectCard>

  <ProjectCard projectTitle="Smart IR Remote Implementation at Telkom University Landmark Tower" projectDescription="Developed a smart IR remote system for efficient management of appliances in Telkom University's Landmark Tower." projectLink="https://drive.google.com/file/d/1XHpp1rLRX3G1feKWdout7FjIcBlS2xTu/view?usp=sharing">
