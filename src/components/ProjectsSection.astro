---
import ProjectCard from '@components/ProjectCard.astro'
import Typescript from '@assets/icons/typescript.astro';
import React from '@assets/icons/react.astro';
import Supabase from '@assets/icons/supabase.astro';
import Tailwind from '@assets/icons/tailwind.astro';
---

<section class="my-20">
  <h2 class="text-2xl font-semibold mb-2">Project</h2>
  <hr class="mb-6 border-zinc-600">

  <ProjectCard projectTitle="Example 1" projectDescription="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam in dui mauris. Vivamus hendrerit arcu sed erat molestie vehicula." projectLink="https://github.com/username/project1" image="https://placehold.co/300x250">
    <React />
    <Supabase />
    <Tailwind />
    <Typescript />
  </ProjectCard>

  <ProjectCard projectTitle="Example 2" projectDescription="Fusce dapibus, tellus ac cursus commodo, tortor mauris condimentum nibh, ut fermentum massa justo sit amet risus. Donec id elit non mi porta gravida." projectLink="https://github.com/username/project2" image="https://placehold.co/300x250">
    <React />
    <Supabase />
    <Tailwind />
  </ProjectCard>
</section>