---
const skills = {
  frontend: ["HTML", "CSS", "JavaScript", "React", "Tailwind", "Astro"],
  backend: ["Node", "Express", "MySQL", "PostgreSQL"],
  tools: ["Bash", "Git", "GitHub", "VSCode", "Docker", "Nginx", "Tableau"]
};
---

<section class="my-20">
  <h2 class="text-2xl font-semibold mb-1">Skills</h2>
  <hr class="mb-6 border-zinc-600">

  <h3 class="text-xl font-medium mb-4">Frontend</h3>
  <div class="flex flex-wrap gap-3">
    {skills.frontend.map(skill => (
      <span class="px-3 py-1 bg-zinc-800 rounded-md">{skill}</span>
    ))}
  </div>

  <h3 class="text-xl font-medium mt-6 mb-4">Backend</h3>
  <div class="flex flex-wrap gap-3">
    {skills.backend.map(skill => (
      <span class="px-3 py-1 bg-zinc-800 rounded-md">{skill}</span>
    ))}
  </div>

  <h3 class="text-xl font-medium mt-6 mb-4">Tools</h3>
  <div class="flex flex-wrap gap-3">
    {skills.tools.map(skill => (
      <span class="px-3 py-1 bg-zinc-800 rounded-md">{skill}</span>
    ))}
  </div>
</section>